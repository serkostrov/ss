# --- apps/web ---
# Local (.env): used by Vite. Production (Dokploy): set the same names as runtime Environment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=http://localhost:5173
# Public links to APSS bots (shown in messenger bind dialog)
VITE_TELEGRAM_BOT_URL=https://t.me/YourBot
VITE_MAX_BOT_URL=https://max.ru/YourBot
# Public HTTPS origin of messenger worker (Dokploy messenger domain). Required for send from web.
# Local vite: leave empty and run messenger on :8787 (proxy /api/messenger).
VITE_MESSENGER_API_URL=

# --- apps/messenger (runtime secrets, never in web image) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
# Raw Max bot token (do NOT prefix with "Bearer "). API: platform-api2.max.ru
MAX_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_BASE_URL=https://your-domain.example
PORT=8787
LOG_LEVEL=info
# Set to 1 only if Max API TLS fails (missing Минцифры CA). Prefer NODE_EXTRA_CA_CERTS.
# MAX_TLS_INSECURE=1

# --- Email notifications via smtp.bz (messenger /v1/notification-email) ---
# SMTPBZ_API_KEY=
# SMTP_FROM=noreply@your-domain.example
# SMTP_FROM_NAME=АПСС(ЭР)
# APP_URL=https://app.example.com
# EMAIL_WEBHOOK_SECRET=random-long-string
#
# After migration 000046, point DB trigger to messenger:
#   update public.app_settings
#   set value = 'https://hooks.example.com/v1/notification-email'
#   where key = 'notification_email_webhook_url';
#   update public.app_settings
#   set value = 'same-as-EMAIL_WEBHOOK_SECRET'
#   where key = 'notification_email_webhook_secret';
#
# Password reset emails also go through messenger + smtp.bz.
# Required on messenger: SMTPBZ_API_KEY, SMTP_FROM, APP_URL, SUPABASE_SERVICE_ROLE_KEY
# Apply migration 20260819000075_password_reset_tokens.sql, then rebuild messenger.
